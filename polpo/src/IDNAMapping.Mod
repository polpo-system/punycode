MODULE IDNAMapping;

(* Generated by tools/generate.py; Unicode 16.0.0. See NOTICE. *)
(* polpo: the table in the data file IDNAMapping.txt, see Load *)

IMPORT Files, Out;

CONST
  words = 41217;  (* polpo: the numbers of the table *)
  count* = 8324;
  pool* = 33296;

VAR table: POINTER TO ARRAY OF LONGINT;  (* the table, read from the data file at load *)

(* polpo: the numbers come from the data file IDNAMapping.txt (in share/ of the polpo root), six
  hexadecimal digits each, written from the string constants of voc's generated module by
  IDNATables.Extract: the polpo compilers take strings of fewer than 128 characters and 16 KB
  of them in a module *)
PROCEDURE Load;
VAR f: Files.File; R: Files.Rider; i, k, v, d: LONGINT; c: CHAR;
BEGIN
  table := NIL; f := Files.Old("IDNAMapping.txt");
  IF f = NIL THEN Out.String("IDNAMapping: IDNAMapping.txt not found"); Out.Ln; RETURN END;
  IF Files.Length(f) # words * 6 THEN
    Out.String("IDNAMapping: IDNAMapping.txt has the wrong length"); Out.Ln; RETURN
  END;
  NEW(table, words); Files.Set(R, f, 0); i := 0;
  WHILE i < words DO
    v := 0; k := 0;
    WHILE k < 6 DO
      Files.Read(R, c); d := ORD(c) - ORD("0"); IF d > 9 THEN DEC(d, 7) END;
      v := v * 16 + d; INC(k)
    END;
    table[i] := v; INC(i)
  END
END Load;

PROCEDURE Word*(index: LONGINT): LONGINT;
BEGIN
  ASSERT(table # NIL, 100); ASSERT((index >= 0) & (index < words), 101);
  RETURN table[index]
END Word;

PROCEDURE Find*(character: LONGINT): LONGINT;
  VAR lo, hi, mid: LONGINT;
BEGIN
  lo := 0; hi := count;
  WHILE lo+1 < hi DO
    mid := (lo+hi) DIV 2;
    IF Word(mid*4) <= character THEN lo := mid ELSE hi := mid END
  END;
  RETURN lo*4
END Find;

BEGIN
  Load
END IDNAMapping.
