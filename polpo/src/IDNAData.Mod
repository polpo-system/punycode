MODULE IDNAData;

(* Generated by tools/generate.py; Unicode 16.0.0. See NOTICE. *)
(* polpo: the table in the data file IDNAData.txt, see Load *)

IMPORT Files, out;

CONST
  words = 20942;  (* polpo: the numbers of the table *)
  propertiesCount* = 4183;
  decompCount* = 2081;
  decompBase* = 8366;
  decompPool* = 14609;
  compCount* = 961;
  compBase* = 18059;

VAR table: POINTER TO ARRAY OF LONGINT;  (* the table, read from the data file at load *)

(* polpo: the numbers come from the data file IDNAData.txt (in share/ of the polpo root), six
  hexadecimal digits each, written from the string constants of voc's generated module by
  IDNATables.Extract: the polpo compilers take strings of fewer than 128 characters and 16 KB
  of them in a module *)
PROCEDURE Load;
VAR f: Files.File; R: Files.Rider; i, k, v, d: LONGINT; c: CHAR;
BEGIN
  table := NIL; f := Files.Old("IDNAData.txt");
  IF f = NIL THEN out.String("IDNAData: IDNAData.txt not found"); out.Ln; RETURN END;
  IF Files.Length(f) # words * 6 THEN
    out.String("IDNAData: IDNAData.txt has the wrong length"); out.Ln; RETURN
  END;
  NEW(table, words); Files.Set(R, f, 0); i := 0;
  WHILE i < words DO
    v := 0; k := 0;
    WHILE k < 6 DO
      Files.Read(R, c); d := ORD(c) - ORD("0"); IF d > 9 THEN DEC(d, 7) END;
      v := v * 16 + d; INC(k)
    END;
    table[i] := v; INC(i)
  END
END Load;

PROCEDURE Word*(index: LONGINT): LONGINT;
BEGIN
  ASSERT(table # NIL, 100); ASSERT((index >= 0) & (index < words), 101);
  RETURN table[index]
END Word;

PROCEDURE Properties*(character: LONGINT): LONGINT;
  VAR lo, hi, mid: LONGINT;
BEGIN
  lo := 0; hi := propertiesCount;
  WHILE lo+1 < hi DO
    mid := (lo+hi) DIV 2;
    IF Word(mid*2) <= character THEN lo := mid ELSE hi := mid END
  END;
  RETURN Word(lo*2+1)
END Properties;

PROCEDURE Combining*(character: LONGINT): LONGINT;
BEGIN RETURN Properties(character) MOD 256
END Combining;

PROCEDURE Decomposition*(character: LONGINT; VAR offset, count: LONGINT);
  VAR lo, hi, mid, value: LONGINT;
BEGIN
  lo := 0; hi := decompCount; count := 0; offset := 0;
  WHILE lo < hi DO
    mid := (lo+hi) DIV 2; value := Word(decompBase+mid*3);
    IF value < character THEN lo := mid+1
    ELSIF value > character THEN hi := mid
    ELSE offset := decompPool+Word(decompBase+mid*3+1); count := Word(decompBase+mid*3+2); RETURN
    END
  END
END Decomposition;

PROCEDURE Compose*(first, second: LONGINT): LONGINT;
  VAR lo, hi, mid, a, b: LONGINT;
BEGIN
  IF (first >= 1100H) & (first < 1113H) & (second >= 1161H) & (second < 1176H) THEN
    RETURN 0AC00H+((first-1100H)*21+second-1161H)*28
  END;
  IF (first >= 0AC00H) & (first < 0D7A4H) & ((first-0AC00H) MOD 28 = 0) &
     (second > 11A7H) & (second < 11C3H) THEN RETURN first+second-11A7H END;
  lo := 0; hi := compCount;
  WHILE lo < hi DO
    mid := (lo+hi) DIV 2; a := Word(compBase+mid*3); b := Word(compBase+mid*3+1);
    IF (a < first) OR ((a = first) & (b < second)) THEN lo := mid+1
    ELSIF (a > first) OR ((a = first) & (b > second)) THEN hi := mid
    ELSE RETURN Word(compBase+mid*3+2)
    END
  END;
  RETURN -1
END Compose;

